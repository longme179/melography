# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are significant hard line breaks in some contexts;
# trailing whitespace trimming above is safe for our style (we use blank lines).
max_line_length = off

[*.{rs,toml}]
indent_size = 4

[*.{py,sh}]
indent_size = 4

[Makefile]
indent_style = tab
